rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isStudent() {
      return hasRole('student');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      // Only admins can create/update users or change roles
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
    }

    // 2. Students collection
    match /students/{studentId} {
      allow read: if isAdmin() || isTeacher() || (isStudent() && getUserData().linkedEntityId == studentId);
      allow write: if isAdmin();
    }

    // 3. Teachers collection
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. Groups collection
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. Subjects collection
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 6. Schedules / Timetables
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 7. Electronic Journal & Grades
    match /grades/{gradeId} {
      allow read: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentId == getUserData().linkedEntityId);
      // Only teachers and admins can create, edit, or delete grades; students CANNOT write
      allow write: if isAdmin() || isTeacher();
    }

    // 8. Attendance
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentId == getUserData().linkedEntityId);
      // Only teachers and admins can mark attendance; students CANNOT modify
      allow write: if isAdmin() || isTeacher();
    }

    // 9. Homeworks
    match /homework/{homeworkId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    // 10. Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 11. Settings & Metadata
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 12. Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Append-only audit trail
    }
  }
}
